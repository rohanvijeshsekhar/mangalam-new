<!DOCTYPE html>
<html lang="en">
<%- include('components/head', { pageTitle: 'Careers - Mangalam Travel & Tours' }) %>
<body class="font-dm-sans bg-white">
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/95 border-b border-gray-100 py-4">
        <div class="container mx-auto px-4 flex items-center justify-between">
            <a href="/"><img src="/assets/images/logo-color.png" alt="Logo" class="h-10"></a>
            <a href="/" class="text-sm font-semibold text-red-600">Home</a>
        </div>
    </header>
    <main class="pt-28 py-12 container mx-auto px-4 max-w-2xl">
        <h1 class="text-3xl font-bold font-[Quicksand] mb-4 text-center">Join Our Team</h1>
        <p class="text-gray-600 text-center mb-8">Build your career with one of the most trusted travel agencies.</p>
        <form action="/action/submitCareerEnquiry.php" method="POST" enctype="multipart/form-data" class="bg-gray-50 p-8 rounded-2xl border border-gray-100 space-y-4">
            <div><label class="block text-sm font-medium mb-1">Full Name</label><input type="text" name="name" required class="w-full p-3 border rounded-xl"></div>
            <div><label class="block text-sm font-medium mb-1">Email</label><input type="email" name="email" required class="w-full p-3 border rounded-xl"></div>
            <div><label class="block text-sm font-medium mb-1">Phone</label><input type="tel" name="phone" required class="w-full p-3 border rounded-xl"></div>
            <div><label class="block text-sm font-medium mb-1">Position Applied For</label><input type="text" name="position" required class="w-full p-3 border rounded-xl"></div>
            <div><label class="block text-sm font-medium mb-1">Upload Resume (PDF/Doc)</label><input type="file" name="resume" required class="w-full p-3 border rounded-xl"></div>
            <button type="submit" class="w-full bg-red-600 text-white font-semibold py-3 rounded-xl">Submit Application</button>
        </form>
    </main>
</body>
</html>
