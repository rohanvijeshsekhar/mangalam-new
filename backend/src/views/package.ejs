<!DOCTYPE html>
<html lang="en">
<% 
const safeDest = typeof destinationName !== 'undefined' ? destinationName : 'Destination';
const safeType = typeof type !== 'undefined' ? type : 'package';
const activeTab = safeType === 'ticket' ? 'tickets' : (safeType === 'activities' || safeType === 'activity' ? 'activity' : 'packages');
const coverImg = typeof cover !== 'undefined' && cover ? cover : '';
const desc = typeof description !== 'undefined' ? description : '';
const listData = typeof data !== 'undefined' && data ? data : [];
const imgDir = safeType === 'ticket' ? 'tickets' : (safeType === 'activities' || safeType === 'activity' ? 'activities' : 'packages');
const innerPath = safeType === 'ticket' ? 'tickets-details.php' : (safeType === 'activities' || safeType === 'activity' ? 'activity-details.php' : 'package-details.php');
%>
<%- include('components/head', { 
    pageTitle: safeType === 'package' ? `Best Personalized Holiday Packages in ${safeDest} | Mangalam Travel & Tours` : (safeType === 'ticket' ? `Top Tickets and Attractions in ${safeDest} | Mangalam Travel & Tours` : `Best Activities in ${safeDest} | Mangalam Travel & Tours`),
    pageDescription: `Explore amazing tour packages, tickets and activities in ${safeDest} with Mangalam Travel & Tours. Book customized travel packages for an unforgettable journey.`,
    pageKeywords: `${safeDest.toLowerCase()} tour packages, holiday packages, customized tours, Mangalam Tours`,
    pageImage: './assets/images/destination-banner.webp',
    pageUrl: ''
}) %>
<body class="font-dm-sans bg-white">
    <script>
        window.initialActiveTab = '<%= activeTab %>';
    </script>
    <!-- Header -->
    <%- include('components/header') %>

    <main class="pt-20 md:pt-24">
        <!-- Hero Section -->
        <section class="relative h-[45vh] min-h-[340px] overflow-hidden flex items-center justify-center" data-aos="fade-up">
            <div class="absolute inset-0<%= !coverImg ? ' bg-gray-800' : '' %>" data-aos="zoom-in" data-aos-delay="100">
                <% if (coverImg) { %>
                <img src="<%= resolveImgUrl(coverImg, 'destinations') %>" alt="<%= safeDest %>" class="w-full h-full object-cover md:rounded-br-[150px]">
                <% } %>
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/40 to-black/20 md:rounded-br-[150px]"></div>
            </div>

            <div class="relative z-10 container mx-auto px-4 text-center pb-12" data-aos="fade-up" data-aos-delay="150">
                <h1 class="text-4xl md:text-5xl font-bold text-white font-[Quicksand] leading-tight drop-shadow-md" data-aos="fade-up" data-aos-delay="200">
                    <%= safeDest %>
                </h1>
                <% if (desc) { %>
                <p class="text-white/90 text-sm md:text-base mt-2 font-dm-sans max-w-xl mx-auto drop-shadow-sm"><%= desc %></p>
                <% } %>
            </div>

            <!-- Navigation Tabs -->
            <div class="absolute bottom-0 left-0 w-full" data-aos="fade-up" data-aos-delay="250">
                <div class="w-full max-w-md mx-auto px-2 sm:px-0">
                    <div class="flex justify-between sm:justify-center bg-white rounded-t-2xl overflow-x-auto no-scrollbar">
                        <div class="relative flex-1 sm:flex-none text-center">
                            <a href="/package.php?slug=<%= encodeURIComponent(slug) %>&type=package" id="tab-packages" class="px-4 sm:px-8 py-3 sm:py-4 <%= (activeTab === 'packages') ? 'text-gray-900' : 'text-gray-400 hover:text-gray-700' %> font-semibold text-[15px] sm:text-lg transition-colors block whitespace-nowrap">
                                Packages
                            </a>
                            <div id="indicator-packages" class="absolute top-0 left-1/2 transform -translate-x-1/2 w-16 sm:w-20 h-1 bg-red-600 rounded-full <%= (activeTab === 'packages') ? '' : 'hidden' %>"></div>
                        </div>

                        <div class="relative flex-1 sm:flex-none text-center">
                            <a href="/package.php?slug=<%= encodeURIComponent(slug) %>&type=ticket" id="tab-tickets" class="px-4 sm:px-8 py-3 sm:py-4 <%= (activeTab === 'tickets') ? 'text-gray-900' : 'text-gray-400 hover:text-gray-700' %> font-semibold text-[15px] sm:text-lg transition-colors block whitespace-nowrap">
                                Tickets
                            </a>
                            <div id="indicator-tickets" class="absolute top-0 left-1/2 transform -translate-x-1/2 w-16 sm:w-20 h-1 bg-red-600 rounded-full <%= (activeTab === 'tickets') ? '' : 'hidden' %>"></div>
                        </div>

                        <div class="relative flex-1 sm:flex-none text-center">
                            <a href="/package.php?slug=<%= encodeURIComponent(slug) %>&type=activities" id="tab-activity" class="px-4 sm:px-8 py-3 sm:py-4 <%= (activeTab === 'activity') ? 'text-gray-900' : 'text-gray-400 hover:text-gray-700' %> font-semibold text-[15px] sm:text-lg transition-colors block whitespace-nowrap">
                                Attractions
                            </a>
                            <div id="indicator-activity" class="absolute top-0 left-1/2 transform -translate-x-1/2 w-16 sm:w-20 h-1 bg-red-600 rounded-full <%= (activeTab === 'activity') ? '' : 'hidden' %>"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Travel Package Cards -->
        <section id="section-packages" class="py-16 bg-white <%= (activeTab === 'packages') ? '' : 'hidden' %>" data-aos="fade-up">
            <div class="container mx-auto px-4">
                <div class="mb-8 text-center" data-aos="fade-up" data-aos-delay="100">
                    <h2 class="text-3xl font-bold text-gray-800 mb-2" data-aos="fade-up" data-aos-delay="150">Popular Packages In <span class="text-red-600"><%= safeDest %></span></h2>
                    <p class="text-gray-600" data-aos="fade-up" data-aos-delay="200"><%= desc %></p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <% if (listData && listData.length > 0) { %>
                        <% listData.forEach(function(item, idx) { 
                            const imageFile = item.card_image || item.image || item.cardImage || 'package-card-1.webp';
                            const imagePath = resolveImgUrl(imageFile, imgDir);
                            const detailUrl = `/${innerPath}?slug=${encodeURIComponent(item.slug_url || '')}`;
                            const title = item.title || item.package_title || item.name || 'Untitled';
                            const amount = item.amount || item.display_amount || '0';
                            const duration = item.duration || '';
                        %>
                            <a href="<%= detailUrl %>" class="rounded-2xl cursor-pointer group" data-aos="zoom-in" data-aos-delay="<%= idx * 120 %>">
                                <div class="relative overflow-hidden rounded-3xl transition-all duration-300">
                                    <img src="<%= imagePath %>" alt="<%= title %>" class="w-full h-auto object-cover group-hover:scale-110 transition-transform duration-500">
                                    <% if (duration) { %>
                                        <div class="flex items-center justify-center gap-2 absolute top-4 right-4 bg-yellow-300 text-black px-3 py-1 rounded-full text-sm font-semibold">
                                            <i class="fi fi-rr-night-day flex justify-center items-center"></i>
                                            <span><%= duration %></span>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="mt-4">
                                    <% if (Number(amount) > 0) { %>
                                    <div class="text-gray-800 text-xl font-bold">₹ <%= Number(amount).toLocaleString('en-IN') %></div>
                                    <% } %>
                                    <h3 class="text-gray-700 text-lg font-semibold font-dm-sans"><%= title %></h3>
                                </div>
                            </a>
                        <% }); %>
                    <% } else { %>
                        <div class="col-span-full text-center py-12" data-aos="fade-up"><p class="text-gray-500">No packages available for this destination.</p></div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Tickets Tab Section -->
        <section id="section-tickets" class="py-16 bg-gray-50 <%= (activeTab === 'tickets') ? '' : 'hidden' %>" data-aos="fade-up">
            <div class="container mx-auto px-4">
                <div class="mb-8 text-center" data-aos="fade-up" data-aos-delay="100">
                    <h2 class="text-3xl font-bold text-gray-800 mb-2" data-aos="fade-up" data-aos-delay="150">Popular Tickets In <span class="text-red-600"><%= safeDest %></span></h2>
                    <p class="text-gray-600" data-aos="fade-up" data-aos-delay="200"><%= desc %></p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <% if (listData && listData.length > 0) { %>
                        <% listData.forEach(function(item, idx) { 
                            const imageFile = item.card_image || item.image || item.cardImage || 'ticket-card-1.webp';
                            const imagePath = resolveImgUrl(imageFile, imgDir);
                            const detailUrl = `/${innerPath}?slug=${encodeURIComponent(item.slug_url || '')}`;
                            const title = item.title || item.short_title || item.name || 'Untitled';
                            const amount = item.display_amount || item.amount || '0';
                        %>
                            <a href="<%= detailUrl %>" class="rounded-3xl cursor-pointer group" data-aos="zoom-in" data-aos-delay="<%= idx * 120 %>">
                                <div class="relative overflow-hidden rounded-3xl">
                                    <img src="<%= imagePath %>" alt="<%= title %>" class="w-full h-auto object-cover group-hover:scale-110 transition-transform duration-500">
                                </div>
                                <div class="mt-3">
                                    <div class="flex items-center text-sm mb-1 font-[Quicksand] text-red-500">
                                        <i class="fi fi-rr-marker mr-1.5"></i>
                                        <span><%= safeDest %></span>
                                    </div>
                                    <h3 class="text-lg font-bold font-dm-sans text-gray-800 leading-tight"><%= title %></h3>
                                    <% if (Number(amount) > 0) { %>
                                    <div class="text-base font-semibold font-dm-sans text-gray-800 mt-1">₹ <%= Number(amount).toLocaleString('en-IN') %></div>
                                    <% } %>
                                </div>
                            </a>
                        <% }); %>
                    <% } else { %>
                        <div class="col-span-full text-center py-12" data-aos="fade-up"><p class="text-gray-500">No tickets available for this destination.</p></div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Activity Tab Section -->
        <section id="section-activity" class="py-16 bg-gray-50 <%= (activeTab === 'activity') ? '' : 'hidden' %>" data-aos="fade-up">
            <div class="container mx-auto px-4">
                <div class="mb-8 text-center" data-aos="fade-up" data-aos-delay="100">
                    <h2 class="text-3xl font-bold text-gray-800 mb-2" data-aos="fade-up" data-aos-delay="150">Popular Activities In <span class="text-red-600"><%= safeDest %></span></h2>
                    <p class="text-gray-600" data-aos="fade-up" data-aos-delay="200"><%= desc %></p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <% if (listData && listData.length > 0) { %>
                        <% listData.forEach(function(item, idx) { 
                            const imageFile = item.card_image || item.image || item.cardImage || 'activity-card-1.webp';
                            const imagePath = resolveImgUrl(imageFile, imgDir);
                            const detailUrl = `/${innerPath}?slug=${encodeURIComponent(item.slug_url || '')}`;
                            const title = item.title || item.short_title || item.name || 'Untitled';
                        %>
                            <a href="<%= detailUrl %>" class="rounded-3xl cursor-pointer group" data-aos="zoom-in" data-aos-delay="<%= idx * 120 %>">
                                <div class="relative overflow-hidden rounded-3xl">
                                    <img src="<%= imagePath %>" alt="<%= title %>" class="w-full h-auto object-cover group-hover:scale-110 transition-transform duration-500">
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
                                    <div class="absolute bottom-0 left-0 right-0 p-4">
                                        <div class="flex items-center mb-2">
                                            <i class="fi fi-rr-ferris-wheel text-white text-sm mr-2 flex items-center justify-center"></i>
                                            <span class="text-white text-base font-[Quicksand]"><%= safeDest %></span>
                                        </div>
                                        <h3 class="text-white text-xl font-semibold font-dm-sans line-clamp-2"><%= title %></h3>
                                    </div>
                                </div>
                            </a>
                        <% }); %>
                    <% } else { %>
                        <div class="col-span-full text-center py-12" data-aos="fade-up"><p class="text-gray-500">No activities available for this destination.</p></div>
                    <% } %>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <%- include('components/footer') %>
    <%- include('components/Customize') %>
    <%- include('components/FixedCustomizeButton') %>
    <%- include('components/MobileNav', { activePage: 'package' }) %>
    <%- include('components/script') %>
</body>
</html>
