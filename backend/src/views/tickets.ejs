<!DOCTYPE html>
<html lang="en">
<%- include('components/head', { 
    pageTitle: 'Top Attraction Tickets & Passes | Mangalam Travel & Tours', 
    pageDescription: 'Book official entry tickets, theme park passes and attraction tickets with instant confirmation at Mangalam Travel & Tours.', 
    pageKeywords: 'attraction tickets, theme park tickets, travel passes, Mangalam Tours',
    pageImage: './assets/images/tickets-1.webp',
    pageUrl: '/tickets.php'
}) %>
<body class="font-dm-sans bg-gray-50">
    <%- include('components/EnquiryOtpFields') %>
    <%- include('components/header') %>

    <main class="pt-20 md:pt-24 min-h-screen">
        <!-- Hero Banner -->
        <section class="relative h-[38vh] min-h-[280px] bg-gradient-to-r from-red-900 via-gray-900 to-black overflow-hidden flex items-center justify-center">
            <div class="absolute inset-0 opacity-40">
                <img src="./assets/images/tickets-1.webp" alt="Tickets Banner" class="w-full h-full object-cover">
            </div>
            <div class="relative z-10 container mx-auto px-4 text-center">
                <h1 class="text-3xl md:text-5xl font-bold text-white font-[Quicksand] mb-3 drop-shadow-md">
                    Attraction Tickets & Entry Passes
                </h1>
                <p class="text-white/90 text-sm md:text-base max-w-xl mx-auto font-dm-sans drop-shadow-sm">
                    Book official theme park tickets, museum passes and top attraction entry vouchers with instant confirmation.
                </p>
            </div>
        </section>

        <!-- Notice Bar if active -->
        <% if (typeof latestNotice !== 'undefined' && latestNotice) { %>
            <div class="bg-red-600 text-white py-2 px-4 text-center text-sm font-medium">📢 <%= latestNotice %></div>
        <% } %>

        <!-- Tickets Listing Section -->
        <section class="py-12 md:py-16 container mx-auto px-4">
            <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-[Quicksand]">Available Attraction Tickets</h2>
                    <p class="text-gray-600 text-sm mt-1">Explore all available ticket deals across top destinations</p>
                </div>
                <div class="flex items-center gap-3">
                    <span class="text-sm font-semibold text-gray-700">Total Available:</span>
                    <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full"><%= (typeof tickets !== 'undefined' && tickets) ? tickets.length : 0 %> Tickets</span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
                <% if (typeof tickets !== 'undefined' && tickets && tickets.length > 0) { %>
                    <% tickets.forEach(function(item, idx) { 
                        const img = item.card_image || item.image || item.cardImage || 'ticket-card-1.webp';
                        const imagePath = resolveImgUrl(img, 'tickets');
                        const detailUrl = `/tickets-details.php?id=${encodeURIComponent(item.ticket_id || item.slug_url || item.id)}`;
                        const title = item.title || item.short_title || 'Attraction Ticket';
                        const amount = item.display_amount || item.amount || 0;
                        const destObj = (typeof destinations !== 'undefined' && destinations) ? destinations.find(d => d.destination_id == item.destination_id) : null;
                        const destName = destObj ? destObj.destination_name : (item.destination_name || 'Global');
                    %>
                        <div class="bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group border border-gray-100">
                            <div class="relative overflow-hidden aspect-[4/3]">
                                <img src="<%= imagePath %>" alt="<%= title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.onerror=null; this.src='./assets/images/logo-color.png';">
                                <div class="absolute top-3 left-3 bg-black/60 backdrop-blur-md text-white text-xs px-3 py-1 rounded-full font-medium flex items-center gap-1">
                                    <i class="fi fi-rr-marker text-red-400"></i> <%= destName %>
                                </div>
                                <% if (item.featured == 1) { %>
                                <div class="absolute top-3 right-3 bg-red-600 text-white text-xs px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider">
                                    Featured
                                </div>
                                <% } %>
                            </div>

                            <div class="p-5 flex-1 flex flex-col justify-between">
                                <div>
                                    <h3 class="text-base font-bold font-dm-sans text-gray-800 leading-snug line-clamp-2 group-hover:text-red-600 transition-colors">
                                        <%= title %>
                                    </h3>
                                    <% if (item.description) { %>
                                    <p class="text-xs text-gray-500 mt-2 line-clamp-2"><%= item.description.replace(/<[^>]*>?/gm, '') %></p>
                                    <% } %>
                                </div>

                                <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between">
                                    <div>
                                        <span class="text-[11px] text-gray-400 block font-medium">Starting from</span>
                                        <span class="text-lg font-bold text-gray-900 font-dm-sans">₹ <%= Number(amount).toLocaleString('en-IN') %></span>
                                    </div>
                                    <a href="<%= detailUrl %>" class="bg-red-600 text-white text-xs font-semibold px-4 py-2 rounded-xl hover:bg-red-700 transition-colors flex items-center gap-1">
                                        Book Ticket <i class="fi fi-rr-arrow-right text-[10px]"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-span-full text-center py-16 bg-white rounded-3xl border border-gray-100">
                        <i class="fi fi-rr-ticket text-5xl text-gray-300 mb-3 block"></i>
                        <h3 class="text-lg font-bold text-gray-700 mb-1">No Tickets Available Currently</h3>
                        <p class="text-gray-500 text-sm">Please check back soon or explore our popular holiday packages.</p>
                        <a href="/package.php" class="mt-4 inline-block bg-red-600 text-white text-xs font-semibold px-5 py-2.5 rounded-xl hover:bg-red-700 transition-colors">View All Packages</a>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <%- include('components/footer') %>
</body>
</html>
