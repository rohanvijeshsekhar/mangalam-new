<!DOCTYPE html>
<html lang="en">
<% 
const pkg = (typeof pkgData !== 'undefined' && pkgData) ? pkgData : {};
const title = pkg.title || pkg.package_title || 'Package Details';
const amount = pkg.amount || 0;
const duration = pkg.duration || '';
const hotelType = pkg.hotel_type || '';
const category = pkg.category || '';
const fixedDate = pkg.fixed_departure_date || pkg.fixed_date || '';
const description = (pkg.description || '').replace(/<[^>]*>?/gm, '').trim();
const highlights = pkg.highlights || [];
const includes = pkg.includes || [];
const excludes = pkg.excludes || [];
const itineraries = pkg.itineraries || pkg.itinearys || [];
const faqs = pkg.faqs || pkg.faq || [];

// Image processing
let imageList = [];
if (pkg.images && pkg.images.length > 0) {
    pkg.images.forEach(img => {
        const name = typeof img === 'object' ? (img.image_name || img.file_name || img.image) : img;
        if (name) imageList.push(name);
    });
}
if (imageList.length === 0 && pkg.card_image) {
    imageList.push(pkg.card_image);
}

// Assemble Key Details Array (Mandatory 4 + extra fields)
const keyDetails = [];
keyDetails.push({ label: 'Duration', icon: 'fi-rr-clock', value: duration || 'N/A' });
keyDetails.push({ label: 'Hotel', icon: 'fi-rr-hotel', value: hotelType || 'N/A' });
keyDetails.push({ label: 'Transfers', icon: 'fi-rr-plane', value: pkg.transportation || 'Included' });

if (category === 'fixed_departures' && fixedDate) {
    keyDetails.push({ label: 'Start Date', icon: 'fi-rr-calendar', value: fixedDate });
} else {
    keyDetails.push({ label: 'Activities', icon: 'fi-rr-canoe', value: `${pkg.no_of_activites !== undefined && pkg.no_of_activites !== '' ? pkg.no_of_activites : 4} Included` });
}

if (pkg.cancellation) {
    keyDetails.push({ label: 'Cancellation', icon: 'fi-rr-document', value: pkg.cancellation });
}
%>
<%- include('components/head', { 
    pageTitle: `${title} - Mangalam Travel & Tours | Package Details`,
    pageDescription: description || `Explore ${title} with Mangalam Travel & Tours.`,
    pageKeywords: `${title.toLowerCase()}, tour package, travel package, Mangalam Tours`,
    pageImage: imageList.length > 0 ? resolveImgUrl(imageList[0], 'packages') : './assets/images/logo-color.png',
    pageUrl: ''
}) %>
<body class="font-dm-sans bg-white">
    <!-- Header -->
    <%- include('components/header') %>

    <main>
        <!-- Package Details Section -->
        <section data-aos="fade-up" class="pt-24 pb-16">
            <div class="container mx-auto px-4">
                <!-- Image Collage Banner -->
                <% if (imageList && imageList.length > 0) { %>
                <!-- Desktop Layout -->
                <div class="hidden lg:flex gap-5 mb-8 h-[450px]" data-aos="zoom-in" data-aos-delay="100">
                    <div class="<%= imageList.length > 1 ? 'w-3/5' : 'w-full' %> relative overflow-hidden rounded-2xl">
                        <img src="<%= resolveImgUrl(imageList[0], 'packages') %>" alt="<%= title %>" class="w-full h-full object-cover">
                    </div>
                    
                    <% if (imageList.length > 1) { %>
                    <div class="w-2/5 grid grid-cols-2 gap-4">
                        <% imageList.slice(1, 5).forEach(function(imgName, gi) { %>
                        <div class="relative overflow-hidden rounded-xl h-full">
                            <img src="<%= resolveImgUrl(imgName, 'packages') %>" alt="<%= title %>" class="w-full h-full object-cover">
                        </div>
                        <% }); %>
                    </div>
                    <% } %>
                </div>
                
                <!-- Mobile Layout Carousel -->
                <div class="lg:hidden mb-8" data-aos="zoom-in" data-aos-delay="150">
                    <div class="overflow-x-auto flex gap-4 no-scrollbar">
                        <% imageList.forEach(function(imgName) { %>
                        <div class="min-w-[85vw] h-64 rounded-2xl overflow-hidden flex-shrink-0">
                            <img src="<%= resolveImgUrl(imgName, 'packages') %>" alt="<%= title %>" class="w-full h-full object-cover">
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- Left Column - Main Content -->
                    <div class="lg:col-span-2 space-y-8">
                        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 font-[Quicksand]"><%= title %></h1>
                        
                        <!-- Key Details Cards -->
                        <div class="bg-gray-50 border border-gray-200/80 rounded-2xl overflow-hidden shadow-sm" data-aos="fade-up" data-aos-delay="260">
                            <% if (keyDetails.length <= 4) { %>
                            <!-- 4-Box Structure filling 100% screen width smoothly -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-gray-200/80">
                                <% keyDetails.forEach(function(item) { %>
                                <div class="p-6 flex flex-col justify-center">
                                    <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2"><%= item.label %></div>
                                    <div class="flex items-center gap-3">
                                        <i class="fi <%= item.icon %> text-red-600 text-lg"></i>
                                        <div class="text-base font-bold text-gray-800"><%= item.value %></div>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                            <% } else { %>
                            <!-- Extended Grid Structure for > 4 fields -->
                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 p-6">
                                <% keyDetails.forEach(function(item) { %>
                                <div>
                                    <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1"><%= item.label %></div>
                                    <div class="flex items-center gap-2 font-bold text-gray-800">
                                        <i class="fi <%= item.icon %> text-red-600 text-lg"></i> <%= item.value %>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                            <% } %>
                        </div>

                        <!-- Overview Section -->
                        <% if (description) { %>
                        <div class="space-y-3">
                            <h2 class="text-2xl font-bold text-gray-900 font-[Quicksand]">Overview</h2>
                            <p class="text-gray-600 leading-relaxed font-dm-sans"><%= description %></p>
                        </div>
                        <% } %>

                        <!-- Highlights Section -->
                        <% if (highlights && highlights.length > 0) { %>
                        <div class="space-y-4">
                            <h2 class="text-2xl font-bold text-gray-900 font-[Quicksand]">Tour Highlights</h2>
                            <ul class="space-y-3">
                                <% highlights.forEach(function(item) { 
                                    const text = typeof item === 'object' ? (item.highlights || item.text) : item;
                                    if (text) {
                                %>
                                <li class="flex items-start gap-3 text-gray-700">
                                    <i class="fi fi-rr-check-circle text-red-600 text-lg mt-0.5"></i>
                                    <span><%= text %></span>
                                </li>
                                <% } }); %>
                            </ul>
                        </div>
                        <% } %>

                        <!-- Itinerary Section -->
                        <% if (itineraries && itineraries.length > 0) { %>
                        <div class="space-y-6">
                            <h2 class="text-2xl font-bold text-gray-900 font-[Quicksand]">Day by Day Itinerary</h2>
                            <div class="space-y-4">
                                <% itineraries.forEach(function(day, idx) { 
                                    const dayNum = day.day || (idx + 1);
                                    const dayTitle = day.title || `Day ${dayNum}`;
                                    const dayDesc = (day.description || '').replace(/<[^>]*>?/gm, '').trim();
                                %>
                                <div class="bg-gray-50 border border-gray-100 rounded-2xl p-6">
                                    <div class="flex items-center gap-3 mb-2">
                                        <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full">Day <%= dayNum %></span>
                                        <h3 class="text-lg font-bold text-gray-900 font-[Quicksand]"><%= dayTitle %></h3>
                                    </div>
                                    <p class="text-gray-600 text-sm leading-relaxed mt-2"><%= dayDesc %></p>
                                </div>
                                <% }); %>
                            </div>
                        </div>
                        <% } %>

                        <!-- Inclusions & Exclusions -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <% if (includes && includes.length > 0) { %>
                            <div class="bg-green-50/50 border border-green-100 rounded-2xl p-6">
                                <h3 class="text-xl font-bold text-gray-900 mb-4 font-[Quicksand]">Inclusions</h3>
                                <ul class="space-y-3">
                                    <% includes.forEach(function(item) { 
                                        const text = typeof item === 'object' ? (item.includes || item.text) : item;
                                        if (text) {
                                    %>
                                    <li class="flex items-start gap-2 text-sm text-gray-700">
                                        <i class="fi fi-rr-check text-green-600 mt-0.5"></i>
                                        <span><%= text %></span>
                                    </li>
                                    <% } }); %>
                                </ul>
                            </div>
                            <% } %>

                            <% if (excludes && excludes.length > 0) { %>
                            <div class="bg-red-50/50 border border-red-100 rounded-2xl p-6">
                                <h3 class="text-xl font-bold text-gray-900 mb-4 font-[Quicksand]">Exclusions</h3>
                                <ul class="space-y-3">
                                    <% excludes.forEach(function(item) { 
                                        const text = typeof item === 'object' ? (item.excludes || item.text) : item;
                                        if (text) {
                                    %>
                                    <li class="flex items-start gap-2 text-sm text-gray-700">
                                        <i class="fi fi-rr-cross text-red-600 mt-0.5"></i>
                                        <span><%= text %></span>
                                    </li>
                                    <% } }); %>
                                </ul>
                            </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Right Column - Booking Form -->
                    <div class="space-y-6">
                        <div class="sticky top-28 bg-white border border-gray-100 shadow-xl shadow-gray-100 rounded-3xl p-6">
                            <% if (Number(amount) > 0) { %>
                            <div class="mb-6">
                                <span class="text-xs text-gray-400 font-bold uppercase tracking-wider">Starting From</span>
                                <div class="text-3xl font-bold text-gray-900 font-[Quicksand] mt-1">₹ <%= Number(amount).toLocaleString('en-IN') %></div>
                            </div>
                            <% } %>

                            <form id="package-enquiry-form" class="space-y-4">
                                <div>
                                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Your Name</label>
                                    <input type="text" id="package-name" required placeholder="John Doe" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-red-600">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Email Address</label>
                                    <input type="email" id="package-email" required placeholder="john@example.com" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-red-600">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Phone Number</label>
                                    <input type="tel" id="package-phone" required placeholder="+91 98765 43210" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-red-600">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Special Requirements</label>
                                    <textarea id="package-notes" rows="3" placeholder="Travel dates, guest count..." class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-red-600 resize-none"></textarea>
                                </div>
                                <button type="submit" id="package-enquire-btn" class="w-full py-4 bg-red-600 text-white rounded-xl font-bold uppercase tracking-wider hover:bg-red-700 transition-colors shadow-lg shadow-red-600/30">
                                    Enquire Now
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('components/footer') %>
    <%- include('components/Customize') %>
    <%- include('components/FixedCustomizeButton') %>
    <%- include('components/MobileNav', { activePage: 'package' }) %>
    <%- include('components/script') %>
</body>
</html>