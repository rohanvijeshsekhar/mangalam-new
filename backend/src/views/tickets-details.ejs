<!DOCTYPE html>
<html lang="en">
<% 
const tkt = typeof ticketData !== 'undefined' && ticketData ? ticketData : null;
const title = tkt ? (tkt.title || tkt.short_title || 'Ticket Details') : 'Ticket Booking';
const img = tkt ? (tkt.card_image || 'ticket-card-1.webp') : 'ticket-card-1.webp';
const imagePath = resolveImgUrl(img, 'tickets');
const amount = tkt ? (tkt.display_amount || tkt.amount || 0) : 0;
const childAmount = tkt ? (tkt.child_amount || 0) : 0;
const discountAmount = tkt ? (tkt.discount_amount || 0) : 0;
const desc = tkt ? (tkt.description || '') : '';
const highlights = tkt && tkt.highlights ? (Array.isArray(tkt.highlights) ? tkt.highlights : []) : [];
const includes = tkt && tkt.includes ? (Array.isArray(tkt.includes) ? tkt.includes : []) : [];
const excludes = tkt && tkt.excludes ? (Array.isArray(tkt.excludes) ? tkt.excludes : []) : [];
%>
<%- include('components/head', { 
    pageTitle: `${title} | Mangalam Travel & Tours`,
    pageDescription: `Book official entry tickets for ${title} with instant confirmation at Mangalam Travel & Tours.`,
    pageKeywords: `${title.toLowerCase()}, entry ticket, attraction pass, Mangalam Tours`,
    pageImage: imagePath,
    pageUrl: '/tickets-details.php'
}) %>
<body class="font-dm-sans bg-gray-50">
    <%- include('components/EnquiryOtpFields') %>
    <%- include('components/header') %>

    <main class="pt-20 md:pt-24 min-h-screen">
        <% if (tkt) { %>
        <!-- Ticket Hero Banner -->
        <section class="relative h-[40vh] min-h-[300px] overflow-hidden flex items-center justify-center bg-gray-900">
            <img src="<%= imagePath %>" alt="<%= title %>" class="absolute inset-0 w-full h-full object-cover opacity-50" onerror="this.onerror=null; this.src='./assets/images/logo-color.png';">
            <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-900/60 to-transparent"></div>
            <div class="relative z-10 container mx-auto px-4 text-center max-w-3xl">
                <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-3 inline-block">Official Ticket Pass</span>
                <h1 class="text-3xl md:text-5xl font-bold text-white font-[Quicksand] leading-tight drop-shadow-md"><%= title %></h1>
            </div>
        </section>

        <!-- Main Details Content -->
        <section class="py-12 container mx-auto px-4 max-w-6xl">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Left Details Column -->
                <div class="lg:col-span-2 space-y-8">
                    <!-- Key Ticket Specifications Grid -->
                    <div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-gray-100">
                        <h3 class="text-xl font-bold text-gray-900 font-[Quicksand] mb-6 flex items-center gap-2">
                            <i class="fi fi-rr-list-check text-red-600"></i> Ticket Specifications & Info
                        </h3>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                            <% if (tkt.hotel_type) { %>
                            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">
                                <span class="text-xs text-gray-400 font-medium block mb-1">Hotel Type</span>
                                <span class="text-sm font-bold text-gray-800 flex items-center gap-1.5">
                                    <i class="fi fi-rr-building text-red-500"></i> <%= tkt.hotel_type %>
                                </span>
                            </div>
                            <% } %>

                            <% if (tkt.duration) { %>
                            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">
                                <span class="text-xs text-gray-400 font-medium block mb-1">Duration</span>
                                <span class="text-sm font-bold text-gray-800 flex items-center gap-1.5">
                                    <i class="fi fi-rr-clock text-amber-500"></i> <%= tkt.duration %>
                                </span>
                            </div>
                            <% } %>

                            <% if (tkt.cancellation) { %>
                            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">
                                <span class="text-xs text-gray-400 font-medium block mb-1">Cancellation</span>
                                <span class="text-sm font-bold text-gray-800 flex items-center gap-1.5">
                                    <i class="fi fi-rr-cross-circle text-rose-500"></i> <%= tkt.cancellation %>
                                </span>
                            </div>
                            <% } %>

                            <% if (tkt.transportation) { %>
                            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">
                                <span class="text-xs text-gray-400 font-medium block mb-1">Transportation</span>
                                <span class="text-sm font-bold text-gray-800 flex items-center gap-1.5">
                                    <i class="fi fi-rr-bus text-blue-500"></i> <%= tkt.transportation %>
                                </span>
                            </div>
                            <% } %>

                            <% if (tkt.required_age) { %>
                            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">
                                <span class="text-xs text-gray-400 font-medium block mb-1">Required Age</span>
                                <span class="text-sm font-bold text-gray-800 flex items-center gap-1.5">
                                    <i class="fi fi-rr-user text-emerald-500"></i> <%= tkt.required_age %>
                                </span>
                            </div>
                            <% } %>

                            <% if (tkt.validity || tkt.Validity) { %>
                            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">
                                <span class="text-xs text-gray-400 font-medium block mb-1">Validity</span>
                                <span class="text-sm font-bold text-gray-800 flex items-center gap-1.5">
                                    <i class="fi fi-rr-calendar text-purple-500"></i> <%= tkt.validity || tkt.Validity %>
                                </span>
                            </div>
                            <% } %>

                            <% if (tkt.no_of_activities || tkt.activities) { %>
                            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">
                                <span class="text-xs text-gray-400 font-medium block mb-1">Total Activities</span>
                                <span class="text-sm font-bold text-gray-800 flex items-center gap-1.5">
                                    <i class="fi fi-rr-ticket text-indigo-500"></i> <%= tkt.no_of_activities || tkt.activities %> Included
                                </span>
                            </div>
                            <% } %>
                        </div>

                        <% if (tkt.adult_msg || tkt.children_msg) { %>
                        <div class="mt-6 pt-6 border-t border-gray-100 space-y-3">
                            <% if (tkt.adult_msg) { %>
                            <div class="bg-amber-50 rounded-2xl p-4 border border-amber-100 text-xs text-amber-900 flex items-start gap-2">
                                <i class="fi fi-rr-info text-amber-600 mt-0.5 text-base flex-shrink-0"></i>
                                <div><strong class="font-bold block mb-0.5">Adult Note:</strong> <%= tkt.adult_msg %></div>
                            </div>
                            <% } %>
                            <% if (tkt.children_msg) { %>
                            <div class="bg-blue-50 rounded-2xl p-4 border border-blue-100 text-xs text-blue-900 flex items-start gap-2">
                                <i class="fi fi-rr-info text-blue-600 mt-0.5 text-base flex-shrink-0"></i>
                                <div><strong class="font-bold block mb-0.5">Children Note:</strong> <%= tkt.children_msg %></div>
                            </div>
                            <% } %>
                        </div>
                        <% } %>
                    </div>

                    <!-- Ticket Overview Card -->
                    <div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-gray-100">
                        <h2 class="text-2xl font-bold text-gray-900 font-[Quicksand] mb-4">Ticket Overview</h2>
                        <div class="prose max-w-none text-gray-600 text-sm md:text-base leading-relaxed">
                            <%- desc || '<p>Instant confirmation official entry ticket with access to all standard attraction zones.</p>' %>
                        </div>
                    </div>

                    <% if (highlights && highlights.length > 0) { %>
                    <!-- Highlights -->
                    <div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-gray-100">
                        <h3 class="text-xl font-bold text-gray-900 font-[Quicksand] mb-4 flex items-center gap-2">
                            <i class="fi fi-rr-star text-amber-500"></i> Key Highlights
                        </h3>
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm text-gray-700">
                            <% highlights.forEach(function(h) { %>
                                <li class="flex items-start gap-2">
                                    <i class="fi fi-rr-check-circle text-green-500 mt-0.5 flex-shrink-0"></i>
                                    <span><%= typeof h === 'object' ? (h.highlights || h.text || JSON.stringify(h)) : h %></span>
                                </li>
                            <% }); %>
                        </ul>
                    </div>
                    <% } %>

                    <% if ((includes && includes.length > 0) || (excludes && excludes.length > 0)) { %>
                    <!-- Includes & Excludes -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <% if (includes && includes.length > 0) { %>
                        <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100">
                            <h4 class="text-lg font-bold text-gray-900 font-[Quicksand] mb-3 text-green-700 flex items-center gap-2">
                                <i class="fi fi-rr-check"></i> What's Included
                            </h4>
                            <ul class="space-y-2 text-xs md:text-sm text-gray-600">
                                <% includes.forEach(function(inc) { %>
                                    <li class="flex items-center gap-2">
                                        <i class="fi fi-rr-check text-green-500"></i>
                                        <span><%= typeof inc === 'object' ? (inc.includes || inc.text) : inc %></span>
                                    </li>
                                <% }); %>
                            </ul>
                        </div>
                        <% } %>

                        <% if (excludes && excludes.length > 0) { %>
                        <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100">
                            <h4 class="text-lg font-bold text-gray-900 font-[Quicksand] mb-3 text-red-600 flex items-center gap-2">
                                <i class="fi fi-rr-cross-small"></i> What's Excluded
                            </h4>
                            <ul class="space-y-2 text-xs md:text-sm text-gray-600">
                                <% excludes.forEach(function(exc) { %>
                                    <li class="flex items-center gap-2">
                                        <i class="fi fi-rr-cross-small text-red-400"></i>
                                        <span><%= typeof exc === 'object' ? (exc.excludes || exc.text) : exc %></span>
                                    </li>
                                <% }); %>
                            </ul>
                        </div>
                        <% } %>
                    </div>
                    <% } %>
                </div>

                <!-- Right Booking Widget Column -->
                <div class="lg:col-span-1">
                    <div class="bg-white rounded-3xl p-6 md:p-8 shadow-md border border-gray-100 sticky top-28">
                        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Ticket Pricing</div>
                        <div class="mt-2 flex items-baseline gap-2">
                            <span class="text-3xl font-bold text-gray-900 font-dm-sans">₹ <%= Number(amount).toLocaleString('en-IN') %></span>
                            <span class="text-xs text-gray-500">per adult</span>
                        </div>
                        <% if (Number(childAmount) > 0) { %>
                        <div class="text-xs text-gray-600 mt-1">Child Ticket: ₹ <%= Number(childAmount).toLocaleString('en-IN') %></div>
                        <% } %>
                        <% if (Number(discountAmount) > 0) { %>
                        <div class="text-xs text-green-600 font-medium mt-1">Discount Available: ₹ <%= Number(discountAmount).toLocaleString('en-IN') %> off</div>
                        <% } %>

                        <div class="mt-6 pt-6 border-t border-gray-100 space-y-4">
                            <div class="flex items-center gap-3 text-xs text-gray-600">
                                <i class="fi fi-rr-paper-plane text-red-600 text-base"></i>
                                <span>Instant Confirmation & Mobile Voucher</span>
                            </div>
                            <div class="flex items-center gap-3 text-xs text-gray-600">
                                <i class="fi fi-rr-shield-check text-green-600 text-base"></i>
                                <span>100% Guaranteed Official Tickets</span>
                            </div>

                            <a href="/cart.php" class="w-full mt-4 bg-red-600 text-white font-bold text-sm py-3.5 px-6 rounded-2xl hover:bg-red-700 transition-colors flex items-center justify-center gap-2 shadow-lg shadow-red-600/20">
                                <i class="fi fi-rr-shopping-cart"></i> Book / Add to Cart
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <% } else { %>
        <!-- Ticket Not Found -->
        <section class="py-20 text-center container mx-auto px-4 max-w-md">
            <i class="fi fi-rr-search text-5xl text-gray-300 mb-4 block"></i>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">Ticket Not Found</h2>
            <p class="text-gray-500 text-sm mb-6">The ticket you requested could not be located or may be inactive.</p>
            <a href="/tickets.php" class="bg-red-600 text-white font-semibold text-xs px-6 py-3 rounded-xl hover:bg-red-700 transition-colors">View All Tickets</a>
        </section>
        <% } %>
    </main>

    <!-- Footer -->
    <%- include('components/footer') %>
</body>
</html>
