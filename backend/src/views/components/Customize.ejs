<style>
    @keyframes customizeSlideIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes customizeSlideOut {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(-12px);
        }
    }

    .customize-frame-animate-in {
        animation: customizeSlideIn 0.35s ease both;
    }

    .customize-frame-animate-out {
        animation: customizeSlideOut 0.25s ease forwards;
    }
</style>

<!-- Customize Popup -->
<div id="customizePopup" class="fixed inset-0 z-[9999] customize-popup-hidden items-center justify-center hidden">
    <!-- Shimmer/Backdrop -->
    <div id="customizeShimmer" class="absolute inset-0 bg-black bg-opacity-50 backdrop-blur-sm"></div>
    
    <!-- Popup Container -->
    <div class="relative bg-white rounded-none lg:rounded-3xl shadow-2xl w-full h-full lg:max-w-4xl lg:max-h-[90vh] overflow-hidden flex flex-col">
        <!-- Header -->
        <div class="p-6 border-b border-gray-200 bg-gray-50">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h5 id="popupHeading" class="text-xl font-bold text-gray-800 font-roxborough">Pick Your Travel Dates</h5>
                    <p id="selectedDestinationName" class="text-sm text-gray-600 font-dm-sans mt-1"></p>
                </div>
                <button id="closeCustomizePopup" class="p-2 hover:bg-gray-200 rounded-full transition-colors">
                    <i class="fi fi-rr-cross text-gray-600 text-xl"></i>
                </button>
            </div>
            <div class="mt-6">
                <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                    <div id="customizeProgressBar" class="h-full bg-gradient-to-r from-red-500 to-red-600 rounded-full transition-all duration-300" style="width: 0%;"></div>
                </div>
                <div class="flex flex-wrap items-center justify-between text-xs sm:text-sm font-dm-sans text-gray-500 mt-3 gap-2">
                    <span id="customizeProgressStep" class="font-semibold text-gray-700">Step 1 of 6</span>
                    <span id="customizeProgressPercent" class="text-gray-500">0%</span>
                    <span id="customizeProgressLabel" class="text-gray-500">Pick Your Travel Dates</span>
                </div>
            </div>
        </div>

        <!-- Content Wrapper -->
        <div id="customizeContentWrapper" class="flex-1 overflow-y-auto p-6">
            <!-- Step 1: Date Selection (starting step since destination is pre-selected) -->
            <div id="step1" class="customize-frame customize-frame-active" data-step="1" data-heading="Pick Your Travel Dates">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 font-dm-sans">From Date</label>
                        <div class="relative">
                            <input type="date" id="fromDate" data-date-input="true" data-date-placeholder="DD/MM/YYYY" placeholder="DD/MM/YYYY" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 font-dm-sans cursor-pointer" onclick="this.showPicker()">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 font-dm-sans">To Date</label>
                        <div class="relative">
                            <input type="date" id="toDate" data-date-input="true" data-date-placeholder="DD/MM/YYYY" placeholder="DD/MM/YYYY" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 font-dm-sans cursor-pointer" onclick="this.showPicker()">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 2: Number of Travelers -->
            <div id="step2" class="customize-frame customize-frame-hidden" data-step="2" data-heading="Select Number of Travelers">
                <div class="space-y-6">
                    <!-- Adults -->
                    <div class="bg-white border border-gray-300 rounded-2xl p-4 md:p-6 flex flex-wrap items-center justify-between gap-4">
                        <div class="flex items-center space-x-3 md:space-x-4">
                            <div class="w-10 h-10 md:w-12 md:h-12 bg-gray-100 rounded-full flex items-center justify-center flex-shrink-0">
                                <i class="fi fi-sr-user text-gray-700 text-lg md:text-xl"></i>
                            </div>
                            <div>
                                <h3 class="text-base md:text-lg font-semibold text-gray-800 font-dm-sans">Adults</h3>
                                <p class="text-xs md:text-sm text-gray-500 font-dm-sans">Age 13+</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-3 bg-gray-50 px-3 py-2 rounded-xl sm:bg-transparent sm:p-0">
                            <button type="button" id="adultMinus" class="w-8 h-8 md:w-10 md:h-10 border border-gray-300 rounded-lg flex items-center justify-center hover:bg-gray-100 transition-colors bg-white">
                                <i class="fi fi-rr-minus text-gray-600 text-xs md:text-sm"></i>
                            </button>
                            <input type="number" id="adultCount" value="1" min="1" class="w-12 md:w-16 text-center text-base md:text-lg font-semibold text-gray-800 border-0 focus:ring-0 font-dm-sans bg-transparent" readonly>
                            <button type="button" id="adultPlus" class="w-8 h-8 md:w-10 md:h-10 border border-gray-300 rounded-lg flex items-center justify-center hover:bg-gray-100 transition-colors bg-white">
                                <i class="fi fi-rr-plus text-gray-600 text-xs md:text-sm"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Children -->
                    <div class="bg-white border border-gray-300 rounded-2xl p-4 md:p-6 flex flex-wrap items-center justify-between gap-4">
                        <div class="flex items-center space-x-3 md:space-x-4">
                            <div class="w-10 h-10 md:w-12 md:h-12 bg-gray-100 rounded-full flex items-center justify-center flex-shrink-0">
                                <i class="fi fi-sr-child text-gray-700 text-lg md:text-xl"></i>
                            </div>
                            <div>
                                <h3 class="text-base md:text-lg font-semibold text-gray-800 font-dm-sans">Children</h3>
                                <p class="text-xs md:text-sm text-gray-500 font-dm-sans">Age 3-12</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-3 bg-gray-50 px-3 py-2 rounded-xl sm:bg-transparent sm:p-0">
                            <button type="button" id="childMinus" class="w-8 h-8 md:w-10 md:h-10 border border-gray-300 rounded-lg flex items-center justify-center hover:bg-gray-100 transition-colors bg-white">
                                <i class="fi fi-rr-minus text-gray-600 text-xs md:text-sm"></i>
                            </button>
                            <input type="number" id="childCount" value="0" min="0" class="w-12 md:w-16 text-center text-base md:text-lg font-semibold text-gray-800 border-0 focus:ring-0 font-dm-sans bg-transparent" readonly>
                            <button type="button" id="childPlus" class="w-8 h-8 md:w-10 md:h-10 border border-gray-300 rounded-lg flex items-center justify-center hover:bg-gray-100 transition-colors bg-white">
                                <i class="fi fi-rr-plus text-gray-600 text-xs md:text-sm"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Children Ages -->
                    <div id="childrenAgesContainer" class="customize-children-ages customize-children-ages-hidden">
                        <h4 class="text-base font-semibold text-gray-800 font-dm-sans mb-4">Children Ages</h4>
                        <div id="childrenAgesWrap" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
                    </div>
                </div>
            </div>

            <!-- Step 3: Hotel Category -->
            <div id="step3" class="customize-frame customize-frame-hidden" data-step="3" data-heading="Select Your Preferred Hotel Category">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="customize-hotel-category customize-hotel-category-active bg-white border-2 border-red-500 rounded-2xl p-6 cursor-pointer transition-all" data-type="3 Star">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-3">
                                <i class="fi fi-sr-hotel text-red-500 text-2xl"></i>
                                <span class="text-lg font-semibold text-gray-800 font-dm-sans">3 Star</span>
                            </div>
                            <div class="flex space-x-1">
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                            </div>
                        </div>
                    </div>
                    <div class="customize-hotel-category customize-hotel-category-inactive bg-white border-2 border-gray-300 rounded-2xl p-6 cursor-pointer hover:border-red-500 transition-all" data-type="4 Star">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-3">
                                <i class="fi fi-sr-hotel text-gray-700 text-2xl"></i>
                                <span class="text-lg font-semibold text-gray-800 font-dm-sans">4 Star</span>
                            </div>
                            <div class="flex space-x-1">
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                            </div>
                        </div>
                    </div>
                    <div class="customize-hotel-category customize-hotel-category-inactive bg-white border-2 border-gray-300 rounded-2xl p-6 cursor-pointer hover:border-red-500 transition-all" data-type="5 Star">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-3">
                                <i class="fi fi-sr-hotel text-gray-700 text-2xl"></i>
                                <span class="text-lg font-semibold text-gray-800 font-dm-sans">5 Star</span>
                            </div>
                            <div class="flex space-x-1">
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                            </div>
                        </div>
                    </div>
                    <div class="customize-hotel-category customize-hotel-category-inactive customize-hotel-remark-trigger bg-white border-2 border-gray-300 rounded-2xl p-6 cursor-pointer hover:border-red-500 transition-all" data-type="false">
                        <div class="flex items-center space-x-3">
                            <i class="fi fi-sr-hotel text-gray-700 text-2xl"></i>
                            <span class="text-lg font-semibold text-gray-800 font-dm-sans">I have other preference</span>
                        </div>
                    </div>
                </div>
                <div id="hotelRemark" class="customize-hotel-remark customize-hotel-remark-hidden">
                    <label class="block text-sm font-semibold text-gray-700 mb-2 font-dm-sans">Enter Your Preference</label>
                    <textarea id="hotelRemarkText" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 font-dm-sans" rows="3" placeholder="Describe your hotel preference..."></textarea>
                </div>
            </div>

            <!-- Step 4: Choose Experiences -->
            <div id="step4" class="customize-frame customize-frame-hidden" data-step="4" data-heading="Choose Your Desired Experiences">
                <div class="mb-4">
                    <div class="relative">
                        <input type="text" id="searchExperiences" placeholder="Search experiences (e.g., Ferrari World)" 
                               class="w-full px-4 py-3 pl-12 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 font-dm-sans">
                        <i class="fi fi-rr-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                    </div>
                </div>
                <div id="experiencesContainer" class="grid grid-cols-2 md:grid-cols-3 gap-4">
                    <!-- Experiences will be loaded here -->
                </div>
                <div id="noExperiences" class="customize-no-experiences customize-no-experiences-hidden">
                    <i class="fi fi-rr-search text-gray-300 text-5xl mb-4"></i>
                    <p class="text-gray-500 font-dm-sans">No experiences found</p>
                </div>
            </div>

            <!-- Step 5: Overview -->
            <div id="step5" class="customize-frame customize-frame-hidden" data-step="5" data-heading="Kindly Verify Your Selections">
                <div class="space-y-6">
                    <h4 id="overviewDestinationName" class="text-2xl font-bold text-gray-800 font-roxborough mb-6"></h4>
                    
                    <!-- Summary Cards -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4">
                            <div class="flex items-center justify-between mb-2">
                                <i class="fi fi-rr-calendar text-red-500 text-xl"></i>
                                <button class="customize-edit-btn text-xs text-red-500 hover:text-red-700 font-dm-sans" data-go="1">Edit</button>
                            </div>
                            <p class="text-xs text-gray-500 font-dm-sans mb-1">Travel Dates</p>
                            <div id="overviewDates" class="text-sm font-semibold text-gray-800 font-dm-sans"></div>
                        </div>
                        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4">
                            <div class="flex items-center justify-between mb-2">
                                <i class="fi fi-sr-user text-red-500 text-xl"></i>
                                <button class="customize-edit-btn text-xs text-red-500 hover:text-red-700 font-dm-sans" data-go="2">Edit</button>
                            </div>
                            <p class="text-xs text-gray-500 font-dm-sans mb-1">Travelers</p>
                            <div id="overviewTravelers" class="text-sm font-semibold text-gray-800 font-dm-sans"></div>
                        </div>
                        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4">
                            <div class="flex items-center justify-between mb-2">
                                <i class="fi fi-sr-hotel text-red-500 text-xl"></i>
                                <button class="customize-edit-btn text-xs text-red-500 hover:text-red-700 font-dm-sans" data-go="3">Edit</button>
                            </div>
                            <p class="text-xs text-gray-500 font-dm-sans mb-1">Hotel Category</p>
                            <div id="overviewHotel" class="text-sm font-semibold text-gray-800 font-dm-sans"></div>
                        </div>
                    </div>

                    <!-- Selected Experiences -->
                    <div class="mt-6">
                        <div class="flex items-center justify-between mb-4">
                            <h5 class="text-lg font-semibold text-gray-800 font-dm-sans">Your Chosen Experiences</h5>
                            <button class="customize-edit-btn text-sm text-red-500 hover:text-red-700 font-dm-sans" data-go="4">Edit</button>
                        </div>
                        <div id="overviewExperiences" class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <!-- Selected experiences will be shown here -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 6: Contact Details -->
            <div id="step6" class="customize-frame customize-frame-hidden" data-step="6" data-heading="Enter Your Details">
                <form id="customizeForm" class="space-y-6">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 font-dm-sans">Name of Lead Passenger *</label>
                        <input type="text" id="customizeName" required 
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 font-dm-sans" 
                               placeholder="Enter your name">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 font-dm-sans">Email Address *</label>
                        <input type="email" id="customizeEmail" required 
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 font-dm-sans" 
                               placeholder="Enter your email">
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2 font-dm-sans">Phone Number *</label>
                            <div class="relative flex gap-2">
                                <input type="tel" id="customizePhone" required 
                                       class="flex-1 px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 font-dm-sans" 
                                       placeholder="Enter your phone number">
                                <button type="button" id="sendOtpBtn" class="px-4 py-2 bg-gray-800 text-white rounded-xl hover:bg-gray-900 transition-colors font-dm-sans text-sm font-medium whitespace-nowrap">
                                    Send OTP
                                </button>
                            </div>
                        </div>
                        <div id="otpFieldContainer" class="hidden">
                            <label class="block text-sm font-semibold text-gray-700 mb-2 font-dm-sans">Enter OTP *</label>
                            <div class="relative flex gap-2">
                                <input type="text" id="customizeOtp" maxlength="6"
                                       class="flex-1 px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 font-dm-sans" 
                                       placeholder="6-digit code">
                                <button type="button" id="verifyOtpBtn" class="px-4 py-2 bg-red-600 text-white rounded-xl hover:bg-red-700 transition-colors font-dm-sans text-sm font-medium whitespace-nowrap">
                                    Verify
                                </button>
                            </div>
                            <p id="otpTimer" class="text-xs text-gray-500 mt-1 font-dm-sans"></p>
                        </div>
                    </div>
                    <div id="otpStatusMsg" class="text-sm font-dm-sans hidden"></div>
                </form>
            </div>
        </div>

        <!-- Footer -->
        <div class="flex items-center justify-between p-6 border-t border-gray-200 bg-gray-50">
            <div class="flex items-center space-x-2 text-sm text-gray-600 font-dm-sans"></div>
            <div class="flex items-center space-x-3">
                <button id="customizePrev" class="px-6 py-2 border border-gray-300 rounded-xl text-gray-700 hover:bg-gray-100 transition-colors font-dm-sans font-semibold">
                    Back
                </button>
                <button id="customizeNext" class="px-6 py-3 bg-red-600 text-white rounded-xl hover:bg-red-700 transition-colors font-dm-sans font-semibold">
                    Continue
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Success Popup -->
<div id="customizeSuccessPopup" class="fixed inset-0 z-[60] customize-popup-hidden items-center justify-center hidden">
    <div class="absolute inset-0 bg-black bg-opacity-50 backdrop-blur-sm"></div>
    <div class="relative bg-white rounded-3xl shadow-2xl w-full max-w-md p-8 text-center">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fi fi-rr-check text-green-600 text-3xl"></i>
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mb-2 font-roxborough">Thank You!</h3>
        <p class="text-gray-600 mb-6 font-dm-sans">We have received your request and will contact you soon with a personalized quote.</p>
        <button id="closeSuccessPopup" class="px-6 py-3 bg-red-600 text-white rounded-xl hover:bg-red-700 transition-colors font-dm-sans font-semibold">
            Close
        </button>
    </div>
</div>
