<%
const p = typeof prefix !== 'undefined' ? prefix : 'enquiry';
const cls = typeof inputClass !== 'undefined' ? inputClass : '';
%>
<div class="enquiry-otp-block mt-3" data-otp-prefix="<%= p %>">
    <p class="text-xs text-gray-500 font-dm-sans mb-2">Enter email above, then click Send OTP.</p>
    <div id="<%= p %>-otpFieldContainer" class="hidden">
        <label class="block text-sm font-semibold text-gray-700 mb-2 font-dm-sans">Enter OTP *</label>
        <div class="flex gap-2">
            <input type="text" id="<%= p %>-otp" maxlength="6" inputmode="numeric"
                   autocomplete="one-time-code"
                   class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 font-dm-sans <%= cls %>"
                   placeholder="6-digit code">
            <button type="button" id="<%= p %>-verifyOtpBtn"
                    class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 font-dm-sans text-sm font-medium whitespace-nowrap">
                Verify
            </button>
        </div>
    </div>
    <p id="<%= p %>-otpStatusMsg" class="text-sm font-dm-sans hidden mt-2"></p>
</div>
