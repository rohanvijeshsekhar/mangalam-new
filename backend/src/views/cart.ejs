<!DOCTYPE html>
<html lang="en">
<%- include('components/head', { 
    pageTitle: 'Shopping Cart - Mangalam Travel & Tours',
    pageDescription: 'Review your selected travel activities and tickets.',
    pageKeywords: 'cart, travel booking, mangalam tours'
}) %>
<body class="font-dm-sans bg-white">
    <%- include('components/EnquiryOtpFields') %>

    <header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 transition-all duration-300">
        <div class="container mx-auto px-4 py-4 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2">
                <img src="/assets/images/logo-color.png" alt="Mangalam Travel & Tours" class="h-10 w-auto">
            </a>
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-gray-700">
                <a href="/" class="hover:text-red-600 transition-colors">Home</a>
                <a href="/about.php" class="hover:text-red-600 transition-colors">About Us</a>
                <a href="/package.php" class="hover:text-red-600 transition-colors">Packages</a>
                <a href="/contact.php" class="hover:text-red-600 transition-colors">Contact</a>
                <a href="/cart.php" class="text-red-600 font-semibold flex items-center gap-2">
                    <i class="fi fi-rr-shopping-cart"></i> Cart
                </a>
            </nav>
        </div>
    </header>

    <main class="pt-24 py-12">
        <div class="container mx-auto px-4 max-w-4xl">
            <h1 class="text-3xl font-bold font-[Quicksand] text-gray-900 mb-8 text-center">Your Selected Items</h1>
            
            <div id="cartItemsContainer" class="space-y-4 mb-8">
                <!-- Dynamic LocalStorage Items Loaded Here -->
            </div>

            <div id="cartCheckoutForm" class="bg-gray-50 p-8 rounded-2xl border border-gray-100">
                <h3 class="text-xl font-bold text-gray-900 mb-4">Complete Enquiry Details</h3>
                <form id="checkoutForm" onsubmit="submitCartEnquiryForm(event)" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                        <input type="text" id="custName" required class="w-full px-4 py-3 border border-gray-300 rounded-xl outline-none focus:ring-2 focus:ring-red-500">
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                            <input type="email" id="custEmail" required class="w-full px-4 py-3 border border-gray-300 rounded-xl outline-none focus:ring-2 focus:ring-red-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                            <input type="tel" id="custPhone" required class="w-full px-4 py-3 border border-gray-300 rounded-xl outline-none focus:ring-2 focus:ring-red-500">
                        </div>
                    </div>
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-4 rounded-xl transition-all shadow-md">
                        Proceed to Send Enquiry
                    </button>
                </form>
            </div>
        </div>
    </main>

    <footer class="bg-black text-white py-12">
        <div class="container mx-auto px-4 text-center text-sm text-gray-400">
            <p>© <%= new Date().getFullYear() %> Mangalam Travel & Tours. All Rights Reserved.</p>
        </div>
    </footer>

    <script src="/js/enquiryOtp.js"></script>
    <script>
        function getCartData() {
            try {
                const raw = localStorage.getItem('cartItem');
                return raw ? JSON.parse(`[${raw}]`) : [];
            } catch (e) {
                return [];
            }
        }

        function renderCart() {
            const items = getCartData();
            const container = document.getElementById('cartItemsContainer');
            if (items.length === 0) {
                container.innerHTML = '<div class="text-center py-12 text-gray-500 bg-gray-50 rounded-2xl border border-gray-100">Your cart is currently empty. <a href="/package.php" class="text-red-600 font-semibold underline">Browse activities</a></div>';
                document.getElementById('cartCheckoutForm').style.display = 'none';
                return;
            }

            container.innerHTML = items.map((item, idx) => `
                <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between">
                    <div>
                        <h4 class="font-bold text-gray-900">${item.title || 'Item'}</h4>
                        <p class="text-sm text-gray-600">Date: ${item.date || 'Flexible'} | Adults: ${item.adults || 1}, Children: ${item.children || 0}</p>
                    </div>
                    <button onclick="removeCartItem(${idx})" class="text-red-600 hover:text-red-800 text-sm font-semibold">Remove</button>
                </div>
            `).join('');
        }

        function removeCartItem(index) {
            let items = getCartData();
            items.splice(index, 1);
            localStorage.setItem('cartItem', items.map(i => JSON.stringify(i)).join(','));
            renderCart();
        }

        async function submitCartEnquiryForm(e) {
            e.preventDefault();
            const items = getCartData();
            const name = document.getElementById('custName').value;
            const email = document.getElementById('custEmail').value;
            const phone = document.getElementById('custPhone').value;

            try {
                const res = await fetch('/action/submitEnquiryCart.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email, phone, items: JSON.stringify(items) })
                });
                const data = await res.json();
                if (data.status) {
                    localStorage.removeItem('cartItem');
                    alert('Enquiry submitted successfully!');
                    window.location.href = '/thankyou.php';
                } else {
                    alert(data.message || 'Failed to submit enquiry.');
                }
            } catch (err) {
                alert('Submission error. Please try again.');
            }
        }

        renderCart();
    </script>
</body>
</html>
