<!DOCTYPE html>
<html lang="en">
<% 
const bData = typeof blogData !== 'undefined' ? blogData : null;
const bTitle = bData ? (bData.title || 'Blog Details') : 'Blog Article';
%>
<%- include('components/head', { 
    pageTitle: `${bTitle} - Mangalam Travel & Tours`,
    pageDescription: bData && bData.title ? bData.title : 'Travel blog article from Mangalam Travel & Tours.',
    pageKeywords: 'travel blog, travel tips, destination guides'
}) %>
<body class="font-dm-sans bg-white">
    <%- include('components/EnquiryOtpFields') %>
    <%- include('components/header') %>

    <main class="pt-24 min-h-screen">
        <% if (typeof latestNotice !== 'undefined' && latestNotice) { %>
            <div class="bg-red-600 text-white py-2 px-4 text-center text-sm font-medium">📢 <%= latestNotice %></div>
        <% } %>

        <% if (bData) { %>
            <section class="py-16 bg-white">
                <div class="container mx-auto px-4 max-w-4xl">
                    <div class="mb-6">
                        <a href="/" class="inline-flex items-center gap-2 text-red-600 hover:text-red-700 font-semibold text-sm transition-colors">
                            <i class="fi fi-rr-arrow-left"></i> Back to Home
                        </a>
                    </div>
                    <% 
                        const blogImg = bData.card_image || (bData.images && bData.images.length > 0 ? (typeof bData.images[0] === 'object' ? (bData.images[0].file_name || bData.images[0].name || bData.images[0].image) : bData.images[0]) : '');
                        const mainImage = resolveImgUrl(blogImg, 'blogs');
                    %>
                    <img src="<%= mainImage %>" alt="<%= bTitle %>" class="w-full h-80 md:h-[420px] object-cover rounded-2xl mb-8 shadow-sm" onerror="this.onerror=null; this.src='./assets/images/logo-color.png';">
                    <div class="flex items-center text-gray-500 text-sm mb-4">
                        <i class="fi fi-rr-calendar mr-2"></i>
                        <span><%= bData.date || 'Recent' %></span>
                    </div>
                    <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 font-[Quicksand] mb-6 leading-tight"><%= bTitle %></h1>
                    <div class="prose max-w-none text-gray-700 font-dm-sans leading-relaxed text-base">
                        <%- bData.description || '<p>Detailed article content coming soon.</p>' %>
                    </div>
                </div>
            </section>

            <% if (typeof latestPosts !== 'undefined' && Array.isArray(latestPosts) && latestPosts.length > 0) { %>
                <section class="py-12 bg-gray-50 border-t border-gray-100">
                    <div class="container mx-auto px-4 max-w-6xl">
                        <h2 class="text-2xl font-bold text-gray-900 font-[Quicksand] mb-8">Latest Blog Posts</h2>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <% latestPosts.forEach(function(post) { 
                                const postTitle = post.title || 'Travel Story';
                                const postSlug = post.slug_url || post.blog_id || post.id || '';
                                const postImg = post.card_image || (post.images && post.images.length > 0 ? (typeof post.images[0] === 'object' ? (post.images[0].file_name || post.images[0].name || post.images[0].image) : post.images[0]) : '');
                                const postImagePath = resolveImgUrl(postImg, 'blogs');
                            %>
                                <a href="/blog-details.php?slug=<%= encodeURIComponent(postSlug) %>" class="group bg-white rounded-2xl overflow-hidden border border-gray-200 hover:shadow-md transition-all">
                                    <div class="relative h-44 overflow-hidden">
                                        <img src="<%= postImagePath %>" alt="<%= postTitle %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.onerror=null; this.src='./assets/images/logo-color.png';">
                                    </div>
                                    <div class="p-5">
                                        <h3 class="font-bold text-gray-900 group-hover:text-red-600 transition-colors line-clamp-2"><%= postTitle %></h3>
                                        <p class="text-xs text-gray-500 mt-2"><%= post.date || 'Recent' %></p>
                                    </div>
                                </a>
                            <% }); %>
                        </div>
                    </div>
                </section>
            <% } %>
        <% } else { %>
            <section class="py-24 text-center container mx-auto px-4 max-w-md">
                <i class="fi fi-rr-document text-5xl text-gray-300 mb-4 block"></i>
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Blog Post Not Found</h1>
                <p class="text-gray-500 text-sm mb-6">The requested article could not be located or may have been updated.</p>
                <a href="/blog.php" class="bg-red-600 text-white font-semibold text-xs px-6 py-3 rounded-xl hover:bg-red-700 transition-colors inline-block">← Back to All Blogs</a>
            </section>
        <% } %>
    </main>

    <!-- Footer -->
    <%- include('components/footer') %>
</body>
</html>
