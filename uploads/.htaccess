# Security rule for uploads folder (Hostinger Shared Server)
Options -Indexes -ExecCGI
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule \.(?i:php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|py|asp|aspx|jsp|sh)$ - [F,L]
</IfModule>
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|py|asp|aspx|jsp|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
